[Unit]
Description=Restore the Polaris -> Tableflow federated catalog connection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run as the same account you use for ./scripts/deploy-from-key-vault.sh so both
# share the recovery journal in ~/.local/state/polaris. It must be in the docker group.
User=CHANGE_ME
Group=docker
# Adjust to the checkout location and the deployment's environment file
# (non-secret settings only; secrets come from Key Vault).
WorkingDirectory=/opt/polaris
EnvironmentFile=/etc/polaris/deployment.env
ExecStart=/bin/bash /opt/polaris/scripts/reconcile-federation.sh
