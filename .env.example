# ---- Postgres (Polaris metastore) -------------------------------------------
POSTGRES_USER=M73581
POSTGRES_PASSWORD=change-me-strong

# ---- Polaris bootstrap administrator credentials ----------------------------
# M73580 principal created by scripts/bootstrap.sh (realm ISBUS).
POLARIS_ROOT_CLIENT_ID=M73580
POLARIS_ROOT_CLIENT_SECRET=change-me-strong
POLARIS_REALM=ISBUS

# Symmetric key used to sign OAuth tokens. Generate: openssl rand -base64 48
POLARIS_TOKEN_BROKER_SECRET=change-me-base64

# Optional/informational: public DNS name your existing nginx serves for inbound
# client traffic to Polaris (proxying to this VM:8181). Not used by the scripts.
POLARIS_PUBLIC_HOSTNAME=polaris.example.com

# ---- Azure identity used by Polaris to access ADLS Gen2 ----------------------
# AZURE_TENANT_ID is ALWAYS required: it is the tenant of the storage account and
# is written into the catalog's storageConfigInfo (az account show --query tenantId).
# Option A (recommended): managed identity on the Azure VM.
#   - System-assigned MI: leave AZURE_CLIENT_ID and AZURE_CLIENT_SECRET blank
#     (DefaultAzureCredential -> IMDS).
#   - User-assigned MI:   also set AZURE_CLIENT_ID to the MI's client ID.
# Option B: service principal -> also set AZURE_CLIENT_ID and AZURE_CLIENT_SECRET.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- ADLS Gen2 storage (Tableflow BYOS bucket) -------------------------------
AZURE_STORAGE_ACCOUNT=mystorageacct
AZURE_STORAGE_CONTAINER=tableflow

# ---- Tableflow federation ----------------------------------------------------
# Polaris proxies catalog calls live to the Confluent Tableflow Iceberg REST
# catalog via your existing nginx egress proxy.
# TABLEFLOW_PROXY_BASE_URL may also be https://tableflow.eastus2.azure.confluent.cloud
# to bypass nginx entirely.
TABLEFLOW_PROXY_BASE_URL=https://nginx.example.com
TABLEFLOW_ORG_ID=54c99051-8b33-4f51-b105-132f643b1720
TABLEFLOW_ENV_ID=env-xq8wnq

# Tableflow-scoped Confluent Cloud API key/secret, used as OAuth client
# credentials against the Tableflow token endpoint.
TABLEFLOW_API_KEY=
TABLEFLOW_API_SECRET=

# Optional: OAuth scope for the Tableflow token exchange. Iceberg clients
# default to "catalog"; leave empty to send no scope.
TABLEFLOW_OAUTH_SCOPE=

# Optional: remote catalog name inside the remote service (sent as
# remoteCatalogName / warehouse prefix). Leave empty if not needed.
TABLEFLOW_REMOTE_CATALOG_NAME=

# Optional overrides (defaults are derived from the values above):
# TABLEFLOW_CATALOG_URI = $TABLEFLOW_PROXY_BASE_URL/iceberg/catalog/organizations/$TABLEFLOW_ORG_ID/environments/$TABLEFLOW_ENV_ID
# TABLEFLOW_TOKEN_URI   = $TABLEFLOW_CATALOG_URI/v1/oauth/tokens
TABLEFLOW_CATALOG_URI=
TABLEFLOW_TOKEN_URI=

# Name of the federated (EXTERNAL) catalog created inside Polaris.
POLARIS_CATALOG_NAME=tableflow

# Catalog role created inside the Polaris catalog and granted to the
# bootstrap service_admin principal role.
POLARIS_ADMIN_CATALOG_ROLE=tableflow_reader
